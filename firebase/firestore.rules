rules_version = '2';
// Smart Hisab — owner-only financial data (Master Prompt §18).
// Path layout: users/{uid}/...  Staff roles live in users/{uid}/members/{memberUid}
// with role: owner | manager | staff | readonly, written only by the owner.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function roleOf(uid) {
      return get(/databases/$(database)/documents/users/$(uid)/members/$(request.auth.uid)).data.role;
    }
    function canRead(uid) { return isOwner(uid) || (signedIn() && roleOf(uid) in ['owner','manager','staff','readonly']); }
    function canWrite(uid) { return isOwner(uid) || (signedIn() && roleOf(uid) in ['owner','manager','staff']); }

    match /users/{uid} {
      allow read, write: if isOwner(uid);
      match /members/{memberUid} {
        allow read: if canRead(uid);
        allow write: if isOwner(uid);
      }
      // persons, ledger_entries, collection_schedules, collection_obligations,
      // payments, payment_allocations, accounts, daily_summaries, backups, audit_log
      match /{collection}/{docId} {
        allow read: if canRead(uid);
        allow create, update: if canWrite(uid)
          && request.resource.data.userId == uid
          && request.resource.data.updatedAt != null;
        // Financial history is tombstoned, never hard-deleted from clients (§14).
        allow delete: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
